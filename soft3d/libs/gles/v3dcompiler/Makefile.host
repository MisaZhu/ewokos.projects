# WS6 host oracle build - compiles the SAME platform-independent v3dcompiler
# sources as the device (Makefile) with the native host compiler (clang on
# macOS / gcc on Linux) into host/dump_uniforms, which prints each shadertoy
# effect's fragment uniform stream (QUNIFORM_UNIFORM dword offsets).
#
# The ONLY differences from the device build:
#   - native CC/CXX instead of the aarch64-none-elf cross toolchain;
#   - v3dcompiler_ewokos.c is OMITTED (macOS/glibc supply util_get_process_name,
#     mkstemps, pthread_getcpuclockid, open_memstream, util_tls_qsort_r);
#   - host/dump_uniforms.cpp (the oracle main) is added;
#   - the real host <assert.h>/<syslog.h> are used (no V3D_PORT_DIR shims), but
#     the platform mesa_config.h is still force-included (it probed clean).
#
# Usage:  make -f Makefile.host -j8        (from projects/soft3d/libs/v3dcompiler)
#         ./host/dump_uniforms
#
# This file is a host-only verification harness; it never affects the device
# build or ships in any image.

CC  ?= clang
CXX ?= clang++

V3DROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
CFG     := $(V3DROOT)/../../../../../machines/raspi5/system/libs/bsp/src/g3d/mesa_config.h
HOSTFIX := $(V3DROOT)/host/mesa_host_fixup.h

INC := -Iinclude \
       -Imesa/include -Imesa/src -Imesa/src/broadcom \
       -Imesa/src/compiler -Imesa/src/compiler/glsl -Imesa/src/compiler/nir \
       -Imesa/src/mesa -I../../demos -I../../../apps/teapot

CF   := -w -std=gnu11   $(INC) -include $(CFG) -include $(HOSTFIX) -O1
CXXF := -w -std=gnu++17 $(INC) -include $(CFG) -include $(HOSTFIX) -O1

OBJDIR := host/obj
BIN    := host/dump_uniforms

S := mesa/src

UTIL_EXCL = \
	$(S)/util/build_id.c \
	$(S)/util/cache_ops_aarch64.c $(S)/util/cache_ops_null.c \
	$(S)/util/cache_ops_x86.c $(S)/util/cache_ops_x86_clflushopt.c \
	$(S)/util/disk_cache.c $(S)/util/disk_cache_os.c \
	$(S)/util/fossilize_db.c \
	$(S)/util/mesa_cache_db.c $(S)/util/mesa_cache_db_multipart.c \
	$(S)/util/os_file_notify.c $(S)/util/os_socket.c \
	$(S)/util/parson.c $(S)/util/streaming-load-memcpy.c \
	$(S)/util/thread_sched.c \
	$(S)/util/u_debug_stack.c $(S)/util/u_debug_symbol.c $(S)/util/u_dl.c \
	$(S)/util/u_process.c $(S)/util/u_shader_variant_cache.c \
	$(S)/util/u_sync_provider.c \
	$(S)/util/vl_zscan_data.c $(S)/util/xmlconfig.c
UTIL_C   = $(filter-out $(UTIL_EXCL), $(wildcard $(S)/util/*.c))
FORMAT_C = $(filter-out $(S)/util/format/u_format_tests.c, $(wildcard $(S)/util/format/*.c))
BLAKE3_C = $(S)/util/blake3/blake3.c $(S)/util/blake3/blake3_dispatch.c \
           $(S)/util/blake3/blake3_portable.c $(S)/util/blake3/blake3_neon.c
COMPILER_C = $(S)/compiler/builtin_types.c $(S)/compiler/glsl_types.c \
             $(S)/compiler/shader_enums.c
# nir_stub.c only supplies an empty nir_print_shader() fallback for builds that
# omit nir_print.c; we build the real nir_print.c, so exclude the stub (the
# device archive link tolerated the duplicate, a direct host link does not).
NIR_C    = $(filter-out $(S)/compiler/nir/nir_stub.c, $(wildcard $(S)/compiler/nir/*.c))

GLSL_EXCL = \
	$(S)/compiler/glsl/main.cpp $(S)/compiler/glsl/standalone.cpp \
	$(S)/compiler/glsl/shader_cache.cpp $(S)/compiler/glsl/serialize.cpp
GLSL_CXX = $(filter-out $(GLSL_EXCL), $(wildcard $(S)/compiler/glsl/*.cpp))
GLSL_C   = $(wildcard $(S)/compiler/glsl/*.c)
GLCPP_C  = $(S)/compiler/glsl/glcpp/glcpp-lex.c \
           $(S)/compiler/glsl/glcpp/glcpp-parse.c $(S)/compiler/glsl/glcpp/pp.c

BCOMP_C   = $(wildcard $(S)/broadcom/compiler/*.c)
BQPU_C    = $(wildcard $(S)/broadcom/qpu/*.c)
BCOMMON_C = $(S)/broadcom/common/v3d_tiling.c $(S)/broadcom/common/v3d_debug.c
MESAPROG_C = $(S)/mesa/program/symbol_table.c $(S)/mesa/program/prog_parameter.c
MAINEXT_C  = $(S)/mesa/main/extensions_table.c
C11_C      = $(S)/c11/impl/threads_posix.c $(S)/c11/impl/time.c
STUBS_C    = v3dcompiler_stubs.c
ENTRY_C    = v3dcompiler_backend.c v3dcompiler_algebraic.c v3dcompiler_texlayout.c
ENTRY_CXX  = v3dcompiler_glsl.cpp
TOOL_CXX   = host_dump_uniforms.cpp
HOSTGLUE_C = host/host_glue.c

SRCS_C   = $(UTIL_C) $(FORMAT_C) $(BLAKE3_C) $(COMPILER_C) $(NIR_C) \
           $(GLSL_C) $(GLCPP_C) $(BCOMP_C) $(BQPU_C) $(BCOMMON_C) $(MESAPROG_C) \
           $(MAINEXT_C) $(C11_C) $(STUBS_C) $(ENTRY_C) $(HOSTGLUE_C)
SRCS_CXX = $(GLSL_CXX) $(ENTRY_CXX) $(TOOL_CXX)

OBJS = $(SRCS_C:%.c=$(OBJDIR)/%.o) $(SRCS_CXX:%.cpp=$(OBJDIR)/%.o)

.PHONY: all clean run
all: $(BIN)

$(BIN): $(OBJS)
	@mkdir -p $(dir $(BIN))
	$(CXX) $(OBJS) -o $(BIN) -lm

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CF) -c $< -o $@

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXF) -c $< -o $@

run: $(BIN)
	./$(BIN)

clean:
	rm -rf host/obj $(BIN)
