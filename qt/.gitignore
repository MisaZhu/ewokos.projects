# build.sh output: downloaded tarball and the shadow build tree (also covered
# by the top-level "build*" pattern, listed here for clarity).
/build/

# moc output (*.moc, moc_*.cpp) and object dirs from the plugin/demo build -
# *.o/*.d are already ignored at the projects level, the generated sources
# are not.
/gen/
/aarch64/
/arm/
/x86/
/riscv/

# syncqt writes its forwarding headers into the vendored source tree, not
# the build tree - they are regenerated by every build.sh run.
/qtbase-5.15/include/
